#: app/server.py:144
msgid "<!doctype html><html lang=\"hu\"><head><meta charset=\"utf-8\"><title>Skipwise futtató</title><link rel=\"stylesheet\" href=\"/static/style.css\"></head><body><main><h1>A futtató leállt</h1><p class=\"muted\">Nem vesz fel munkát, amíg újra nem indítod.</p></main></body></html>"
msgstr "<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\"><title>Runner Skipwise</title><link rel=\"stylesheet\" href=\"/static/style.css\"></head><body><main><h1>Le runner est arrêté</h1><p class=\"muted\">Il n'accepte aucune tâche tant que vous ne le relancez pas.</p></main></body></html>"

